app.get('/documenti-conformita/pdf/:id_documento', async (req, res) => {
  const { id_documento } = req.params;
  const connection = await pool.promise().getConnection();

  try {
    // Recupera il documento dal DB
    const [rows] = await connection.query('SELECT * FROM dichiarazione_conformita WHERE id_documento = ?', [id_documento]);

    if (rows.length === 0) {
      return res.status(404).json({ error: "Documento non trovato" });
    }

    const doc = rows[0];

    // Carica il file template PDF
    const templatePath = path.join(__dirname, 'pdf-templates', 'Dichiarazione_conformità_popolato_default.pdf');
    const existingPdfBytes = fs.readFileSync(templatePath);

    const pdfDoc = await PDFDocument.load(existingPdfBytes);
    const form = pdfDoc.getForm();

    // Compila i campi testuali
    form.getTextField('Esecutrice dellimpianto 2 1').setText(doc.esecutrice_impianto || '');	
	form.getTextField('undefined_2').setText(doc.testo_norma_tecnica_impiego || '');
    if (doc.progetto_art_5_7) form.getCheckBox('progetto ai sensi dellart 5 e 75').check();
    if (doc.norma_tecnica_applicabile) form.getCheckBox('seguito la norma tecnica applicabile allimpiego 4').check();
    if (doc.verificato_compatibilita) form.getCheckBox('Verificato la compatibilità tecnica con limpianto preesistente solo per rifacimenti parziali').check();
    if (doc.tipologia_materiali_utilizzati) form.getCheckBox('relazione con tipologie dei materiali utilizzati 6').check();
    if (doc.schema_impianto) form.getCheckBox('schema di impianto realizzato 7').check();
    if (doc.riferimento_dichiarazioni) form.getCheckBox('riferimento a dichiarazioni di conformità precedenti o parziali già esistenti8').check();
    if (doc.copia_certificato_riconoscimento) form.getCheckBox('copia del certificato di riconoscimento dei requisiti tecnicoprofessionali').check();
    if (doc.attestazione_conformita) form.getCheckBox('attestazione di conformità per impianto realizzato con materiali o sistemi non normalizzati 9').check();

    // Finalizza il PDF
    form.flatten(); // blocca i campi
    const pdfBytes = await pdfDoc.save();

    res.setHeader('Content-Type', 'application/pdf');
    res.send(pdfBytes);

  } catch (err) {
    console.error("Errore generazione PDF:", err);
    res.status(500).json({ error: "Errore generazione PDF" });
  } finally {
    connection.release();
  }
});


// Avvia il server
app.listen(port, () => {
  console.log(`Server in ascolto sulla porta ${port}`);
});



