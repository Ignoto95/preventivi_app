// Aggiungi questo endpoint per i documenti di rispondenza
app.post('/documenti-rispondenza', async (req, res) => {
  const connection = await pool.promise().getConnection(); // Ottieni una connessione promise-based

  try {
    const {
      id_cliente,
      in_edificio_uso,
      accertamenti_impianto,
      realizzato_impianto_anno,
      installato_comune,
      installato_prov,
      installato_via,
      installato_n,
      installato_scala,
      installato_piano,
      installato_interno,
      seguito_richiesta,
      relazione_verifica_impianto,
      relazione_altro_testo,
      tipo_documento,
      data_documento
    } = req.body;

    const query = `
      INSERT INTO dichiarazione_rispondenza (
        id_cliente, in_edificio_uso, accertamenti_impianto,
        realizzato_impianto_anno, installato_comune, installato_prov,
        installato_via, installato_n, installato_scala, installato_piano,
        installato_interno, seguito_richiesta, relazione_verifica_impianto,
        relazione_altro_testo, tipo_documento, data_documento
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `;

    const values = [
      id_cliente,
      in_edificio_uso,
      accertamenti_impianto,
      realizzato_impianto_anno,
      installato_comune,
      installato_prov,
      installato_via,
      installato_n,
      installato_scala,
      installato_piano,
      installato_interno,
      seguito_richiesta,
      relazione_verifica_impianto || 0,
      relazione_altro_testo,
      tipo_documento,
      data_documento
    ];

    const [result] = await connection.query(query, values);

    res.status(201).json({
      success: true,
      id_documento: result.insertId,
      message: 'Documento di rispondenza creato con successo'
    });

  } catch (err) {
    console.error("Errore creazione documento rispondenza:", err);
    res.status(500).json({
      success: false,
      error: "Errore durante la creazione del documento",
      details: err.message
    });
  } finally {
    connection.release(); // Rilascia sempre la connessione
  }
});

