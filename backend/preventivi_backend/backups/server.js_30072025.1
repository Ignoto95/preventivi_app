const fileFilter = (req, file, cb) => {
  console.log('File ricevuto:', {
    originalname: file.originalname,
    mimetype: file.mimetype,
    size: file.size
  });

  const allowedTypes = ['application/pdf', 'application/x-pdf', 'application/octet-stream'];

  const isPDF = allowedTypes.includes(file.mimetype) ||
                file.originalname.toLowerCase().endsWith('.pdf');

  if (isPDF) {
    cb(null, true);
  } else {
    console.error('Tipo file non permesso:', file.mimetype);
    cb(new Error('Solo file PDF sono permessi'), false);
  }
};


