// Endpoint per eliminare un singolo allegato
app.delete('/:tipo_documento/:id_documento/delete-allegato/:tipo_allegato', async (req, res) => {
  let connection;
  try {
    const { id_documento, tipo_documento, tipo_allegato } = req.params;

    // Verifiche di validità
    if (!['conformita', 'rispondenza'].includes(tipo_documento)) {
      return res.status(400).json({ error: 'Tipo documento non valido' });
    }

    const tipiAllegatiValidi = ['modulo_a12', 'relazione_materiali', 'relazione_verifica'];
    if (!tipiAllegatiValidi.includes(tipo_allegato)) {
      return res.status(400).json({ error: 'Tipo allegato non valido' });
    }

    connection = await pool.getConnection();

    // 1. Trova l'allegato specifico da eliminare
    const [allegato] = await connection.query(
      `SELECT id_allegato, file_path
       FROM documenti_allegati
       WHERE ${tipo_documento === 'conformita' ? 'id_conformita' : 'id_rispondenza'} = ?
       AND tipo_allegato = ?`,
      [id_documento, tipo_allegato]
    );

    if (allegato.length === 0) {
      return res.status(404).json({ error: 'Allegato non trovato' });
    }

    const filePath = allegato[0].file_path;
    const id_allegato = allegato[0].id_allegato;

    // 2. Elimina il file fisicamente (se esiste)
    try {
      if (fs.existsSync(filePath)) {
        fs.unlinkSync(filePath);
        console.log(`File eliminato: ${filePath}`);
      }
    } catch (err) {
      console.error('Errore eliminazione file:', err);
      // Procedi comunque con l'eliminazione dal DB
    }

    // 3. Elimina il record dal database
    await connection.query(
      `DELETE FROM documenti_allegati WHERE id_allegato = ?`,
      [id_allegato]
    );

    res.json({
      success: true,
      message: 'Allegato eliminato con successo',
      deleted: {
        id_allegato: id_allegato,
        tipo_allegato: tipo_allegato,
        file_path: filePath
      }
    });

  } catch (error) {
    console.error('Errore eliminazione allegato:', error);
    res.status(500).json({
      error: 'Errore durante l\'eliminazione dell\'allegato',
      details: process.env.NODE_ENV === 'development' ? error.message : undefined
    });
  } finally {
    if (connection) connection.release();
  }
});

