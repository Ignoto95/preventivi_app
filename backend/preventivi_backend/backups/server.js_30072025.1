// DELETE DOCUMENTO (CONFORMITA O RISPONDENZA) CON ALLEGATI
app.delete('/documenti/:tipo/:id_documento', async (req, res) => {
  const { tipo, id_documento } = req.params;
  const connection = await pool.getConnection();

  try {
    // Verifica e normalizza il tipo documento
    const tipoNormalizzato = tipo.toLowerCase();
    let tableName;

    if (tipoNormalizzato === 'conformita' || tipoNormalizzato === 'conformità') {
      tableName = 'dichiarazione_conformita';
    } else if (tipoNormalizzato === 'rispondenza') {
      tableName = 'dichiarazione_rispondenza';
    } else {
      return res.status(400).json({ error: "Tipo documento non valido" });
    }

    // Inizia una transazione
    await connection.beginTransaction();

    try {
      // 1. Prima elimina gli allegati associati
      const [allegati] = await connection.query(
        `SELECT id_allegato, file_path
         FROM documenti_allegati
         WHERE ${tipoNormalizzato === 'conformita' ? 'id_conformita' : 'id_rispondenza'} = ?`,
        [id_documento]
      );

      // Elimina i file fisicamente
      for (const allegato of allegati) {
        try {
          if (allegato.file_path && fs.existsSync(allegato.file_path)) {
            fs.unlinkSync(allegato.file_path);
          }
        } catch (err) {
          console.error(`Errore eliminazione file ${allegato.file_path}:`, err);
        }
      }

      // Elimina i record degli allegati
      await connection.query(
        `DELETE FROM documenti_allegati
         WHERE ${tipoNormalizzato === 'conformita' ? 'id_conformita' : 'id_rispondenza'} = ?`,
        [id_documento]
      );

      // 2. Poi elimina il documento padre
      const [result] = await connection.query(
        `DELETE FROM ${tableName} WHERE id_documento = ?`,
        [id_documento]
      );

      if (result.affectedRows === 0) {
        await connection.rollback();
        return res.status(404).json({ error: "Documento non trovato" });
      }

      // Commit della transazione
      await connection.commit();

      res.json({
        success: true,
        message: "Documento e allegati eliminati con successo",
        deleted: {
          id_documento: id_documento,
          tipo_documento: tipoNormalizzato,
          allegati_eliminati: allegati.length
        }
      });

    } catch (err) {
      await connection.rollback();
      throw err;
    }

  } catch (err) {
    console.error("Errore eliminazione documento:", err);
    res.status(500).json({
      error: "Errore durante l'eliminazione del documento",
      details: process.env.NODE_ENV === 'development' ? err.message : undefined
    });
  } finally {
    connection.release();
  }
});

