// Endpoint per upload documenti compilati
app.post('/:tipo_documento/:id_documento/upload', upload.single('documento'), async (req, res) => {
  console.log('Richiesta upload ricevuta:', {
    params: req.params,
    body: req.body,
    file: req.file
  });

  let connection;
  try {
    if (!req.file) {
      console.log('Nessun file ricevuto nella richiesta');
      return res.status(400).json({ error: 'Nessun file caricato' });
    }

    console.log('File ricevuto:', {
      originalname: req.file.originalname,
      mimetype: req.file.mimetype,
      size: req.file.size,
      path: req.file.path
    });

    const { id_documento, tipo_documento } = req.params;
    const { tipo_allegato } = req.body;

    // Verifiche di validità
    if (!['conformita', 'rispondenza'].includes(tipo_documento)) {
      return res.status(400).json({ error: 'Tipo documento non valido' });
    }

    const tipiAllegatiValidi = ['modulo_a12', 'relazione_materiali', 'relazione_verifica'];
    if (!tipiAllegatiValidi.includes(tipo_allegato)) {
      return res.status(400).json({ error: 'Tipo allegato non valido' });
    }

    connection = await pool.getConnection();

    // Verifica esistenza documento padre
    const tableName = tipo_documento === 'conformita'
      ? 'dichiarazione_conformita'
      : 'dichiarazione_rispondenza';

    const [documento] = await connection.query(
      `SELECT 1 FROM ${tableName} WHERE id_documento = ?`,
      [id_documento]
    );

    if (documento.length === 0) {
      return res.status(404).json({ error: 'Documento non trovato' });
    }

    // Prepara i dati per l'inserimento
    const insertData = {
      tipo_allegato,
      file_path: req.file.path,
      dimensione_file: req.file.size
    };

    // Imposta l'ID corretto in base al tipo di documento
    if (tipo_documento === 'conformita') {
      insertData.id_conformita = id_documento;
      insertData.id_rispondenza = null;
    } else {
      insertData.id_rispondenza = id_documento;
      insertData.id_conformita = null;
    }

    // Inserisci l'allegato con i campi necessari
    const [result] = await connection.query(
      `INSERT INTO documenti_allegati SET ?`,
      [insertData]
    );

    res.json({
      success: true,
      message: 'Documento caricato con successo',
      tipo_allegato,
      id_documento,
      id_allegato: result.insertId,
      fileInfo: {
        path: req.file.path,
        name: req.file.filename,
        size: req.file.size,
        type: req.file.mimetype
      }
    });

  } catch (error) {
    console.error('Upload error:', {
      message: error.message,
      stack: error.stack,
      fullError: error
    });
    res.status(500).json({
      error: 'Errore durante il caricamento del documento',
      details: error.message
    });
  } finally {
    if (connection) connection.release();
  }
});

// Endpoint per download documenti compilati
app.get('/:tipo_documento/:id_documento/download/:tipo_allegato', async (req, res) => {
  let connection;
  try {
    const { id_documento, tipo_documento, tipo_allegato } = req.params;

    // Verifiche di validità
    if (!['conformita', 'rispondenza'].includes(tipo_documento)) {
      return res.status(400).json({ error: 'Tipo documento non valido' });
    }

    connection = await pool.getConnection();

    // Recupera direttamente dalla tabella documenti_allegati
  const [allegato] = await connection.query(`
    SELECT file_path
    FROM documenti_allegati
    WHERE ${tipo_documento === 'conformita' ? 'id_conformita' : 'id_rispondenza'} = ?
      AND tipo_allegato = ?
  `, [id_documento, tipo_allegato]);

    if (allegato.length === 0) {
      return res.status(404).json({ error: 'Allegato non trovato' });
    }

    const filePath = allegato[0].file_path;

    if (!fs.existsSync(filePath)) {
      return res.status(404).json({ error: 'File non trovato sul server' });
    }

    const fileName = `${tipo_allegato}_${id_documento}${path.extname(filePath)}`;

    res.download(filePath, fileName, (err) => {
      if (err) {
        console.error('Download error:', err);
        res.status(500).json({ error: 'Errore durante il download' });
      }
    });

  } catch (error) {
    console.error('Download error:', error);
    res.status(500).json({ error: 'Errore durante il recupero del documento' });
  } finally {
    if (connection) connection.release();
  }
});

