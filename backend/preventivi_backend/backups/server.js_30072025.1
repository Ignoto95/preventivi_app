// Route per aggiungere un nuovo condizionatore
app.post('/api/condizionatori', async (req, res) => {
    let connection;
    try {
        const { id_cliente, tipo_condizionatore, potenza, data_installazione, modello, marca } = req.body;

        if (!id_cliente || !tipo_condizionatore || !potenza || !data_installazione) {
            return res.status(400).json({ error: 'Tutti i campi obbligatori sono richiesti' });
        }

        connection = await pool.getConnection();

        const query = `
            INSERT INTO condizionatori
            (id_cliente, tipo_condizionatore, potenza, data_installazione, modello, marca)
            VALUES (?, ?, ?, ?, ?, ?)
        `;
        const [result] = await connection.query(query, [
            id_cliente,
            tipo_condizionatore,
            potenza,
            data_installazione,
            modello || null,
            marca || null
        ]);

        // Recupera il condizionatore appena inserito con la data di scadenza calcolata
        const [condizionatore] = await connection.query(`
            SELECT *,
                   DATE_ADD(data_installazione, INTERVAL 1 YEAR) as data_scadenza
            FROM condizionatori
            WHERE id_condizionatore = ?
        `, [result.insertId]);

        res.status(201).json(condizionatore[0]);
    } catch (error) {
        console.error('Errore nell\'inserimento del condizionatore:', error);
        res.status(500).json({ error: 'Errore del server' });
    } finally {
        if (connection) connection.release();
    }
});

app.delete('/api/condizionatori/:id', async (req, res) => {
    const { id } = req.params;
    const connection = await pool.getConnection();

    try {
        // Verifica che il condizionatore esista
        const [rows] = await connection.query(
            'SELECT * FROM condizionatori WHERE id_condizionatore = ?',
            [id]
        );

        if (rows.length === 0) {
            return res.status(404).json({ error: 'Condizionatore non trovato' });
        }

        // Elimina il condizionatore
        const [result] = await connection.query(
            'DELETE FROM condizionatori WHERE id_condizionatore = ?',
            [id]
        );

        res.status(200).json({ message: 'Condizionatore eliminato con successo' });
    } catch (err) {
        console.error('Errore eliminazione condizionatore:', err);
        res.status(500).json({ error: 'Errore del server' });
    } finally {
        connection.release();
    }
});

