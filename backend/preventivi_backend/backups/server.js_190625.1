//ROUTE PER DICHIARAZIONE DI RISPONDENZA
app.post('/documenti-rispondenza', (req, res) => {
  const {
    id_cliente,
    accertamenti_impianto,
    realizzato_impianto_anno,
    installato_comune,
    installato_prov,
    installato_via,
    installato_n,
    installato_scala,
    installato_piano,
    installato_interno,
    dati_proprietario_cliente,
    in_edificio_uso,
    seguito_richiesta,
    relazione_verifica_impianto,
    relazione_altro_cb,
    relazione_altro_testo,
    copia_certificato,
    tipo_documento,
    data_documento
  } = req.body;

  const query = `
    INSERT INTO dichiarazione_rispondenza (
      id_cliente, accertamenti_impianto, realizzato_impianto_anno,
      installato_comune, installato_prov, installato_via, installato_n,
      installato_scala, installato_piano, installato_interno,
      dati_proprietario_cliente, in_edificio_uso, seguito_richiesta,
      relazione_verifica_impianto, relazione_altro_cb, relazione_altro_testo,
      copia_certificato, tipo_documento, data_documento
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `;

  const values = [
    id_cliente,
    accertamenti_impianto,
    realizzato_impianto_anno,
    installato_comune,
    installato_prov,
    installato_via,
    installato_n,
    installato_scala,
    installato_piano,
    installato_interno,
    dati_proprietario_cliente,
    in_edificio_uso,
    seguito_richiesta,
    relazione_verifica_impianto,
    relazione_altro_cb,
    relazione_altro_testo,
    copia_certificato,
    tipo_documento,
    data_documento
  ];

  pool.query(query, values, (err, result) => {
    if (err) {
      console.error("Errore nell'inserimento del documento di rispondenza:", err);
      res.status(500).send("Errore durante la creazione del documento di rispondenza.");
    } else {
      res.status(201).send({ id_documento: result.insertId });
    }
  });
});

//RECUPERA IL SINGOLO DOCUMENTO DI RISPONDENZA
app.get('/documenti-rispondenza/:id', (req, res) => {
  const { id } = req.params;

  const query = `
    SELECT dr.*, c.nome, c.cognome
    FROM dichiarazione_rispondenza dr
    JOIN clienti c ON dr.id_cliente = c.id_cliente
    WHERE dr.id_documento = ?
  `;

  pool.query(query, [id], (err, result) => {
    if (err) {
      console.error("Errore nel recupero del documento:", err);
      res.status(500).send("Errore durante il recupero del documento");
    } else if (result.length === 0) {
      res.status(404).send("Documento non trovato");
    } else {
      res.status(200).send(result[0]);
    }
  });
});

