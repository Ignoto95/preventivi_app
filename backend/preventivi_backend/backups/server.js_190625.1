//ROUTE PER LETTURA DOCUMENTI PER CLIENTI UNIFICATA (DICHIARAZIONE RISPONDENZA E CONFORMITA)
app.get('/documenti', async (req, res) => {
  const connection = await pool.promise().getConnection();
  try {
    // Query per Documenti di Conformità
    const [conformita] = await connection.query(`
      SELECT
        dc.*,
        'Dichiarazione di Conformità' AS tipo_documento,
        c.nome AS nome_cliente,
        c.cognome AS cognome_cliente,
        'conformita' AS tipo_tabella
      FROM dichiarazione_conformita dc
      JOIN Cliente c ON dc.id_cliente = c.id_cliente
    `);

    // Query per Documenti di Rispondenza
    const [rispondenza] = await connection.query(`
      SELECT
        dr.*,
        'Dichiarazione di Rispondenza' AS tipo_documento,
        c.nome AS nome_cliente,
        c.cognome AS cognome_cliente,
        'rispondenza' AS tipo_tabella
      FROM dichiarazione_rispondenza dr
      JOIN Cliente c ON dr.id_cliente = c.id_cliente
    `);

    // Combina i risultati
    const documenti = [...conformita, ...rispondenza];

    // Ordina per data (opzionale)
    documenti.sort((a, b) => new Date(b.data_documento) - new Date(a.data_documento));

    res.status(200).json(documenti);
  } catch (error) {
    console.error("Errore nel recupero dei documenti:", error);
    res.status(500).send("Errore durante il recupero dei documenti.");
  } finally {
    connection.release();
  }
});


// PUT /documenti/:id MODIFICA DOCUMENTO
app.put('/documenti-conformita/:id_documento', async (req, res) => {
  const { id_documento } = req.params;
  const data = req.body;
  const connection = await pool.promise().getConnection();

  const query = `
    UPDATE dichiarazione_conformita SET
      esecutrice_impianto = ?,
      testo_norma_tecnica_impiego = ?,
      norma_tecnica_applicabile = ?,
      verificato_compatibilita = ?,
      progetto_art_5_7 = ?,
      tipologia_materiali_utilizzati = ?,
      schema_impianto = ?,
      riferimento_dichiarazioni = ?,
      copia_certificato_riconoscimento = ?,
      attestazione_conformita = ?,
          data_documento = ?
    WHERE id_documento = ?
  `;

  const values = [
    data.esecutrice_impianto,
    data.testo_norma_tecnica_impiego,
    data.norma_tecnica_applicabile,
    data.verificato_compatibilita,
    data.progetto_art_5_7,
    data.tipologia_materiali_utilizzati,
    data.schema_impianto,
    data.riferimento_dichiarazioni,
    data.copia_certificato_riconoscimento,
    data.attestazione_conformita,
        data.data_documento,
    id_documento,
  ];

  try {
    const [result] = await connection.query(query, values);

    if (result.affectedRows === 0) {
      return res.status(404).json({ error: "Documento non trovato" });
    }

    res.json({ message: "Documento aggiornato correttamente" });
  } catch (err) {
    console.error("Errore aggiornamento:", err);
    res.status(500).json({ error: "Errore aggiornamento documento" });
  } finally {
    connection.release();
  }
});

// DELETE DOCUMENTO CONFORMITA
app.delete('/documenti-conformita/:id_documento', async (req, res) => {
