const express = require('express');
const router = express.Router();
const pool = require('../config/db');
//const auth = require('../middlewares/auth');
const fs = require("fs");
const { PDFDocument } = require('pdf-lib');
const path = require('path');
const {
  authenticateFirebase,
  authorizeRoles,
  verifyDocumentAccess
} = require('../middlewares');

const ROLES = {
  ADMIN: 'admin',
  TECHNICIAN: 'technician',
  USER: 'user'
};

// Middleware specifico per queste route
router.use(authenticateFirebase);

// POST per l'inserimento del preventivo, cliente e lavori
router.post('/preventivo',authorizeRoles(ROLES.ADMIN), async (req, res) => {
  let { data_preventivo, id_cliente, prezzo_totale, lavori, rate, cliente } = req.body;

  if (!cliente || !lavori || lavori.length === 0 || !data_preventivo) {
        return res.status(400).json({ error: 'Dati mancanti: verifica di aver inserito cliente, data e lavori.' });
  }

  const { nome, cognome, citta, via, email, telefono, codice_fiscale } = cliente;

  const connection = await pool.getConnection();
  try {
        await connection.beginTransaction();

        // Verifica se il cliente esiste già tramite email o codice fiscale
        const [existingClientRows] = await connection.query(
          'SELECT id_cliente FROM Cliente WHERE email = ? OR codice_fiscale = ?',
          [email, codice_fiscale]
        );

        if (existingClientRows.length > 0) {
          // Cliente esistente, aggiorna i dati
          id_cliente = existingClientRows[0].id_cliente;
          await connection.query(
                'UPDATE Cliente SET nome = ?, cognome = ?, citta = ?, via = ?, telefono = ? WHERE id_cliente = ?',
                [nome, cognome, citta, via, telefono, id_cliente]
          );
        } else {
          // Cliente nuovo, inserisci
          const [insertClientResult] = await connection.query(
                'INSERT INTO Cliente (nome, cognome, citta, via, email, telefono, codice_fiscale) VALUES (?, ?, ?, ?, ?, ?, ?)',
                [nome, cognome, citta, via, email, telefono, codice_fiscale]
          );
          id_cliente = insertClientResult.insertId;
        }

        // Inserisci il preventivo con l'acconto (default a 0 se non passato)
         const [insertPreventivoResult] = await connection.query(
         'INSERT INTO Preventivo (data_preventivo, id_cliente, prezzo_totale) VALUES (?, ?, ?)',
         [data_preventivo, id_cliente, prezzo_totale  || 0]
         );
         const id_preventivo = insertPreventivoResult.insertId;

        // Inserisci i lavori associati
        for (const lavoro of lavori) {
          const { tipo_lavoro, descrizione_lavoro, prezzo } = lavoro;
          await connection.query(
                'INSERT INTO Lavoro (id_preventivo, tipo_lavoro, descrizione_lavoro, prezzo) VALUES (?, ?, ?, ?)',
                [id_preventivo, tipo_lavoro, descrizione_lavoro, prezzo]
          );
        }
         // Inserisci le rate, se presenti
         if (Array.isArray(rate) && rate.length > 0) {
         for (const rata of rate) {
                        const { descrizione, percentuale } = rata;
                        if (descrizione && percentuale != null) {
                        await connection.query(
                                                        'INSERT INTO rate_pagamento (id_preventivo, descrizione, percentuale) VALUES (?, ?, ?)',
                                                        [id_preventivo, descrizione, percentuale]
                        );
                        }
         }
         }

        // Ricalcola il totale se non specificato
        if (!prezzo_totale) {
          await connection.query(
                'UPDATE Preventivo SET prezzo_totale = (SELECT IFNULL(SUM(prezzo), 0) FROM Lavoro WHERE id_preventivo = ?) WHERE id_preventivo = ?',
                [id_preventivo, id_preventivo]
          );
        }

        await connection.commit();
        res.status(201).json({ message: 'Preventivo, cliente e lavori inseriti con successo', id_preventivo });
  } catch (err) {
        await connection.rollback();
        console.error(err);
        res.status(500).json({ error: 'Errore durante l\'inserimento del preventivo.' });
  } finally {
        connection.release();
  }
});

// PUT per aggiornare un preventivo e i suoi lavori
router.put('/preventivi/modifica',authorizeRoles(ROLES.ADMIN), async (req, res) => {
  const {
        id_preventivo,
        nome_cliente,
        cognome_cliente,
        via,
        citta,
        prezzo_totale,
        data_preventivo,
        lavori,
        email,
        telefono,
        codice_fiscale,
        rate // Array di oggetti: [{ descrizione, percentuale }]
  } = req.body;

  if (
        !id_preventivo ||
        !nome_cliente ||
        !cognome_cliente ||
        !data_preventivo ||
        !Array.isArray(lavori)
  ) {
        return res.status(400).json({ error: 'Dati mancanti o non validi.' });
  }

  const connection = await pool.getConnection();
  try {
        await connection.beginTransaction();

        // 1. Trova il cliente associato al preventivo
        const [clienteRows] = await connection.query(
          `SELECT Cliente.id_cliente FROM Cliente
           INNER JOIN Preventivo ON Cliente.id_cliente = Preventivo.id_cliente
           WHERE Preventivo.id_preventivo = ?`,
          [id_preventivo]
        );

        if (clienteRows.length === 0) {
          throw new Error('Cliente associato al preventivo non trovato.');
        }

        const id_cliente = clienteRows[0].id_cliente;

        // 2. Aggiorna dati cliente
        await connection.query(
          `UPDATE Cliente
           SET nome = ?, cognome = ?, via = ?, citta = ?, email = ?, telefono = ?, codice_fiscale = ?
           WHERE id_cliente = ?`,
          [nome_cliente, cognome_cliente, via, citta, email || null, telefono || null, codice_fiscale || null, id_cliente]
        );

        // 3. Aggiorna dati preventivo
        await connection.query(
          `UPDATE Preventivo
           SET data_preventivo = ?, prezzo_totale = ?
           WHERE id_preventivo = ?`,
          [data_preventivo, prezzo_totale || 0, id_preventivo]
        );

        // 4. Elimina lavori esistenti
        await connection.query(`DELETE FROM Lavoro WHERE id_preventivo = ?`, [id_preventivo]);

        // 5. Inserisci nuovi lavori
        for (const lavoro of lavori) {
          const { tipo_lavoro, descrizione_lavoro, prezzo } = lavoro;
          await connection.query(
                `INSERT INTO Lavoro (id_preventivo, tipo_lavoro, descrizione_lavoro, prezzo) VALUES (?, ?, ?, ?)`,
                [id_preventivo, tipo_lavoro, descrizione_lavoro, prezzo]
          );
        }

        // 6. Elimina rate esistenti
        await connection.query(`DELETE FROM rate_pagamento WHERE id_preventivo = ?`, [id_preventivo]);

        // 7. Inserisci nuove rate
        if (Array.isArray(rate)) {
          for (const r of rate) {
                const { descrizione, percentuale } = r;
                if (descrizione && percentuale != null) {
                  await connection.query(
                        `INSERT INTO rate_pagamento (id_preventivo, descrizione, percentuale) VALUES (?, ?, ?)`,
                        [id_preventivo, descrizione, percentuale]
                  );
                }
          }
        }

        await connection.commit();
        res.status(200).json({ message: 'Preventivo aggiornato con successo' });
  } catch (err) {
        await connection.rollback();
        console.error(err);
        res.status(500).json({ error: 'Errore durante la modifica del preventivo.' });
  } finally {
        connection.release();
  }
});

// POST Route per generare il PDF
router.post("/generate-pdf/preventivo/:id",authorizeRoles(ROLES.ADMIN), async (req, res) => {
  console.log("📦 Request body:", req.body);
  console.log("📌 Request params:", req.params);
  const {
        nome_cliente,
        cognome_cliente,
        email,
        telefono,
        lavori,
        citta,
        via,
        codice_fiscale,
        data_preventivo,
        prezzo_totale,
        id_preventivo,
                rate
  } = req.body;

  if (!Array.isArray(lavori)) {
        return res.status(400).json({ error: "Campo 'lavori' mancante o non valido" });
  }

const lavoriHtml = lavori.map(l =>
  `<tr>
        <td>
          <span style="font-weight: bold; font-size: 14px;">${l.tipo_lavoro}</span><br>
          <span style="font-weight: normal; font-size: 12px;">${l.descrizione_lavoro}</span>
        </td>
        <td> €${l.prezzo}</td>
  </tr>`
).join("");

let rateHtml = "";

if (Array.isArray(rate) && rate.length > 0) {
  rateHtml = rate.map(r =>
        `<li><strong>${r.descrizione}:</strong> ${r.percentuale}%</li>`
  ).join("");
}
  const dataObj = new Date(data_preventivo);
  const dataScadenzaObj = new Date(dataObj);
  dataScadenzaObj.setDate(dataObj.getDate() + 15);
  const formatDate = (d) =>
        `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;

  const dataPreventivoFormatted = formatDate(dataObj);
  const dataScadenzaFormatted = formatDate(dataScadenzaObj);

  // Carica template HTML
  const templatePath = path.join(__dirname, "templates", "preventivo.html");
  let html = fs.readFileSync(templatePath, "utf-8");

  // Carica e codifica il logo
  const imagePath = path.resolve(__dirname, "public", "images", "logo_az_simone.png");
  let logoBase64 = "";

  try {
        const imageBuffer = fs.readFileSync(imagePath);
        logoBase64 = `data:image/png;base64,${imageBuffer.toString("base64")}`;
  } catch (err) {
  }

  // Sostituisci i placeholder
  html = html.replace(/{{logo_path}}/g, logoBase64)
                         .replace(/{{nome_cliente}}/g, nome_cliente)
                         .replace(/{{cognome_cliente}}/g, cognome_cliente)
                         .replace(/{{email}}/g, email)
                         .replace(/{{telefono}}/g, telefono)
                         .replace(/{{citta}}/g, citta)
                         .replace(/{{via}}/g, via)
                         .replace(/{{codice_fiscale}}/g, codice_fiscale)
                         .replace(/{{data_preventivo}}/g, dataPreventivoFormatted)
                         .replace(/{{data_scadenza}}/g, dataScadenzaFormatted)
                         .replace(/{{prezzo_totale}}/g, prezzo_totale)
                         .replace(/{{lavori}}/g, lavoriHtml)
                         .replace(/{{rate}}/g, rateHtml)
                                                 .replace(/{{id_preventivo}}/g, id_preventivo);


  try {
        const browser = await puppeteer.launch({
          headless: true,
          args: ['--no-sandbox', '--disable-setuid-sandbox'],
        });

        const page = await browser.newPage();
        await page.setContent(html, { waitUntil: "networkidle0" });

        const pdfBuffer = await page.pdf({ format: "A4" });
        await browser.close();

        const fileName = `Preventivo.${nome_cliente}.${cognome_cliente}.pdf`.replace(/\s+/g, "_");
        res.setHeader("Content-Type", "application/pdf");
        res.setHeader("Content-Disposition", `inline; filename="${fileName}"`);
        res.end(pdfBuffer);

  } catch (err) {
        console.error(" Errore durante la generazione del PDF:", err);
        res.status(500).send("Errore durante la generazione del PDF");
  }
});

//Route per eliminare un preventivo
router.delete('/preventivo/:id',authorizeRoles(ROLES.ADMIN), async (req, res) => {
  const id_preventivo = req.params.id;
  const connection = await pool.getConnection();

  try {
        console.log('Inizio eliminazione preventivo ID:', id_preventivo);
        await connection.beginTransaction();

        // Verifica che il preventivo esista (opzionale, ma utile per feedback)
        const [preventivoRows] = await connection.query(
          'SELECT id_cliente FROM Preventivo WHERE id_preventivo = ?',
          [id_preventivo]
        );

        if (preventivoRows.length === 0) {
          console.log('Preventivo non trovato');
          return res.status(404).json({ error: 'Preventivo non trovato' });
        }

        // Elimina le rate associate
        await connection.query('DELETE FROM rate_pagamento WHERE id_preventivo = ?', [id_preventivo]);
        console.log('Rate eliminate');

        // Elimina i lavori associati
        await connection.query('DELETE FROM Lavoro WHERE id_preventivo = ?', [id_preventivo]);
        console.log('Lavori eliminati');

        // Elimina il preventivo
        await connection.query('DELETE FROM Preventivo WHERE id_preventivo = ?', [id_preventivo]);
        console.log('Preventivo eliminato');

        await connection.commit();
        res.status(200).json({ message: 'Preventivo eliminato con successo' });
  } catch (err) {
        await connection.rollback();
        console.error('Errore eliminazione:', err);
        res.status(500).json({ error: 'Errore durante l\'eliminazione del preventivo' });
  } finally {
        connection.release();
  }
});

// GET per ottenere i tipi di lavoro unici, utile per le modifiche e creazioni dei preventivi
router.get('/tipi-lavoro',authorizeRoles(ROLES.ADMIN), async (req, res) => {
  const connection = await pool.getConnection();
  try {
        const [results] = await connection.query(
          'SELECT DISTINCT tipo_lavoro FROM Lavoro ORDER BY tipo_lavoro ASC'
        );
        const tipiLavoro = results.map(row => row.tipo_lavoro);
        res.json(tipiLavoro);
  } catch (error) {
        console.error(error);
        res.status(500).json({ error: 'Errore nel recupero dei tipi di lavoro' });
  } finally {
        connection.release();
  }
});

// GET Route per ottenere le descrizioni di lavoro uniche
router.get('/descrizioni-lavoro',authorizeRoles(ROLES.ADMIN), async (req, res) => {
  const connection = await pool.getConnection();
  try {
        const [results] = await connection.query(
          'SELECT DISTINCT descrizione_lavoro FROM Lavoro WHERE descrizione_lavoro IS NOT NULL AND descrizione_lavoro != "" ORDER BY descrizione_lavoro ASC'
        );
        const descrizioni = results.map(row => row.descrizione_lavoro);
        res.json(descrizioni);
  } catch (error) {
        console.error(error);
        res.status(500).json({ error: 'Errore nel recupero delle descrizioni di lavoro' });
  } finally {
        connection.release();
  }
});

module.exports = router;

