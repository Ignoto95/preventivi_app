//POST Creazione documento di conformità
router.post('/documenti-conformita', async (req, res) => {
  const connection = await pool.getConnection();

  try {
    const {
      id_cliente,
      esecutrice_impianto,
      norma_tecnica_applicabile,
      testo_norma_tecnica_impiego,
      verificato_compatibilita,
      progetto_art_5_7,
      tipologia_materiali_utilizzati,
      schema_impianto,
      riferimento_dichiarazioni,
      copia_certificato_riconoscimento,
      attestazione_conformita,
      tipo_documento,
      data_documento
    } = req.body;

    const query = `
      INSERT INTO dichiarazione_conformita (
        id_cliente, esecutrice_impianto, norma_tecnica_applicabile,
        testo_norma_tecnica_impiego, verificato_compatibilita, progetto_art_5_7,
        tipologia_materiali_utilizzati, schema_impianto, riferimento_dichiarazioni,
        copia_certificato_riconoscimento, attestazione_conformita, tipo_documento, data_documento
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `;

    const values = [
      id_cliente,
      esecutrice_impianto,
      norma_tecnica_applicabile || 0,
      testo_norma_tecnica_impiego,
      verificato_compatibilita || 0,
      progetto_art_5_7 || 0,
      tipologia_materiali_utilizzati || 0,
      schema_impianto || 0,
      riferimento_dichiarazioni || 0,
      copia_certificato_riconoscimento || 0,
      attestazione_conformita || 0,
      tipo_documento,
      data_documento
    ];

    const [result] = await connection.query(query, values);

    res.status(201).json({
      success: true,
      id_documento: result.insertId,
      message: 'Documento di conformità creato con successo'
    });

  } catch (err) {
    console.error("Errore creazione documento conformità:", err);
    res.status(500).json({
      success: false,
      error: "Errore durante la creazione del documento",
      details: err.message
    });
  } finally {
    connection.release();
  }
});

//GET Lettura documenti di conformità per cliente
router.get('/documenti', async (req, res) => {
  const connection = await pool.getConnection();
  try {
        const [conformita] = await connection.query(`
          SELECT dc.*, c.nome AS nome_cliente, c.cognome AS cognome_cliente, 'conformita' AS tipo_documento
          FROM dichiarazione_conformita dc
          JOIN Cliente c ON dc.id_cliente = c.id_cliente
        `);

        const [rispondenza] = await connection.query(`
          SELECT dr.*, c.nome AS nome_cliente, c.cognome AS cognome_cliente, 'rispondenza' AS tipo_documento
          FROM dichiarazione_rispondenza dr
          JOIN Cliente c ON dr.id_cliente = c.id_cliente
        `);

        const documenti = [...conformita, ...rispondenza];
        res.status(200).json(documenti);
  } catch (error) {
        console.error("Errore nel recupero dei documenti:", error);
        res.status(500).send("Errore durante il recupero dei documenti.");
  } finally {
        connection.release();
  }
});

// PUT /documenti/:id per modificare il documento
router.put('/documenti-conformita/:id_documento', async (req, res) => {
  const { id_documento } = req.params;
  const data = req.body;
  const connection = await pool.getConnection();

  const query = `
        UPDATE dichiarazione_conformita SET
          esecutrice_impianto = ?,
          testo_norma_tecnica_impiego = ?,
          norma_tecnica_applicabile = ?,
          verificato_compatibilita = ?,
          progetto_art_5_7 = ?,
          tipologia_materiali_utilizzati = ?,
          schema_impianto = ?,
          riferimento_dichiarazioni = ?,
          copia_certificato_riconoscimento = ?,
          attestazione_conformita = ?,
                  data_documento = ?
        WHERE id_documento = ?
  `;

  const values = [
        data.esecutrice_impianto,
        data.testo_norma_tecnica_impiego,
        data.norma_tecnica_applicabile,
        data.verificato_compatibilita,
        data.progetto_art_5_7,
        data.tipologia_materiali_utilizzati,
        data.schema_impianto,
        data.riferimento_dichiarazioni,
        data.copia_certificato_riconoscimento,
        data.attestazione_conformita,
                data.data_documento,
        id_documento,
  ];

  try {
        const [result] = await connection.query(query, values);

        if (result.affectedRows === 0) {
          return res.status(404).json({ error: "Documento non trovato" });
        }

        res.json({ message: "Documento aggiornato correttamente" });
  } catch (err) {
        console.error("Errore aggiornamento:", err);
        res.status(500).json({ error: "Errore aggiornamento documento" });
  } finally {
        connection.release();
  }
});

// DELETE documento (CONFORMITA O RISPONDENZA) con tutti gli allegati
router.delete('/documenti/:tipo/:id_documento', async (req, res) => {
  const { tipo, id_documento } = req.params;
  const connection = await pool.getConnection();

  try {
    // Verifica e normalizza il tipo documento
    const tipoNormalizzato = tipo.toLowerCase();
    let tableName;

    if (tipoNormalizzato === 'conformita' || tipoNormalizzato === 'conformità') {
      tableName = 'dichiarazione_conformita';
    } else if (tipoNormalizzato === 'rispondenza') {
      tableName = 'dichiarazione_rispondenza';
    } else {
      return res.status(400).json({ error: "Tipo documento non valido" });
    }

    // Inizia una transazione
    await connection.beginTransaction();

    try {
      // 1. Prima elimina gli allegati associati
      const [allegati] = await connection.query(
        `SELECT id_allegato, file_path
         FROM documenti_allegati
         WHERE ${tipoNormalizzato === 'conformita' ? 'id_conformita' : 'id_rispondenza'} = ?`,
        [id_documento]
      );

      // Elimina i file fisicamente
      for (const allegato of allegati) {
        try {
          if (allegato.file_path && fs.existsSync(allegato.file_path)) {
            fs.unlinkSync(allegato.file_path);
          }
        } catch (err) {
          console.error(`Errore eliminazione file ${allegato.file_path}:`, err);
        }
      }

      // Elimina i record degli allegati
      await connection.query(
        `DELETE FROM documenti_allegati
         WHERE ${tipoNormalizzato === 'conformita' ? 'id_conformita' : 'id_rispondenza'} = ?`,
        [id_documento]
      );

      // 2. Poi elimina il documento padre
      const [result] = await connection.query(
        `DELETE FROM ${tableName} WHERE id_documento = ?`,
        [id_documento]
      );

      if (result.affectedRows === 0) {
        await connection.rollback();
        return res.status(404).json({ error: "Documento non trovato" });
      }

      // Commit della transazione
      await connection.commit();

      res.json({
        success: true,
        message: "Documento e allegati eliminati con successo",
        deleted: {
          id_documento: id_documento,
          tipo_documento: tipoNormalizzato,
          allegati_eliminati: allegati.length
        }
      });

    } catch (err) {
      await connection.rollback();
      throw err;
    }

  } catch (err) {
    console.error("Errore eliminazione documento:", err);
    res.status(500).json({
      error: "Errore durante l'eliminazione del documento",
      details: process.env.NODE_ENV === 'development' ? err.message : undefined
    });
  } finally {
    connection.release();
  }
});

